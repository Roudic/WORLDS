# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required. Classifies each request. https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Required to execute routed requests. https://console.anthropic.com/settings/keys
# Without it the router still classifies and decides — use dry run.
ANTHROPIC_API_KEY=

# Optional overrides
# TYPESAFE_MODEL=jev-latest
# PORT=3000
